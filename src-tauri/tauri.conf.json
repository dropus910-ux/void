{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOID",
  "version": "0.1.0",
  "identifier": "com.void.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VOID",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "licenseFile": "assets/LICENSE.txt",
    "shortDescription": "VOID music player"
  }
}